    {
        "id": "28889882baf36d8a",
        "type": "function",
        "z": "b4ccd42c70018948",
        "name": "Auth & Set Threshold",
        "func": "const VALID_KEY = 'iot-secret-key-2026';\nconst apiKey = msg.req.headers['x-api-key'];\nmsg.headers = { 'Access-Control-Allow-Origin': '*' };\n\nif (apiKey !== VALID_KEY) {\n    msg.statusCode = 401;\n    msg.payload = { status: 'error', message: 'Unauthorized: X-API-Key tidak valid' };\n    return msg;\n}\n\nvar val = Number(msg.payload.threshold);\nif (isNaN(val)) {\n    msg.statusCode = 400;\n    msg.payload = { status: 'error', message: 'Nilai threshold harus berupa angka' };\n    return msg;\n}\n\nflow.set('threshold', val);\nmsg.statusCode = 200;\nmsg.payload = {\n    status: 'success',\n    message: 'Batas suhu berhasil diperbarui',\n    threshold: val\n};\nreturn msg;",
        "outputs": 1,
