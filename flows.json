        "z": "b4ccd42c70018948",
        "name": "Auth & Query SQLite",
        "func": "const VALID_KEY = 'iot-secret-key-2026';\nconst apiKey = msg.req.headers['x-api-key'];\nmsg.headers = { 'Access-Control-Allow-Origin': '*' };\n\nif (apiKey !== VALID_KEY) {\n    msg.statusCode = 401;\n    msg.payload = { status: 'error', message: 'Unauthorized: X-API-Key tidak valid' };\n    return [null, msg];\n}\n\nmsg.topic = 'SELECT suhu, kelembaban, timestamp, received FROM sensor_history ORDER BY id DESC LIMIT 50;';\nreturn [msg, null];",
