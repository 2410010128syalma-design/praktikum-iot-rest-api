        "id": "fc03039760bf05c8",
        "type": "function",
        "z": "b4ccd42c70018948",
        "name": "Auth, Validasi & Publish",
        "func": "const VALID_KEY = 'iot-secret-key-2026';\nconst apiKey = msg.req.headers['x-api-key'];\nmsg.headers = { 'Access-Control-Allow-Origin': '*' };\n\nif (apiKey !== VALID_KEY) {\n    msg.statusCode = 401;\n    msg.payload = { status: 'error', message: 'Unauthorized: X-API-Key tidak valid' };\n    return [msg, null];\n}\n\nvar body = msg.payload;\nif (!body.device || !body.action) {\n    msg.statusCode = 400;\n    msg.payload = { status: 'error', message: 'device dan action wajib diisi' };\n    return [msg, null];\n}\n\nvar mqttMsg = { payload: body, topic: 'iot/kontrol' };\nmsg.statusCode = 200;\nmsg.payload = { status: 'success', message: 'Perintah terkirim', sent: body };\nreturn [msg, mqttMsg];",
