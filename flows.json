    {
        "id": "ba1560422167474d",
        "type": "function",
        "z": "b4ccd42c70018948",
        "name": "Simpan SQLite, Cek Threshold & WS",
        "func": "var data = msg.payload;\ndata.received = new Date().toISOString();\nflow.set('lastSensor', data);\n\nvar threshold = flow.get('threshold');\nif (threshold === undefined) {\n    threshold = 30;\n    flow.set('threshold', threshold);\n}\n\nvar isAlert = Number(data.suhu) > Number(threshold);\nvar alertMsg = isAlert\n    ? 'PERINGATAN: Suhu ' + data.suhu + ' C melewati batas (' + threshold + ' C)!'\n    : null;\n\nvar sqlMsg = {\n    topic: \"INSERT INTO sensor_history (suhu, kelembaban, timestamp, received) VALUES (\" +\n        Number(data.suhu) + \", \" +\n        Number(data.kelembaban) + \", '\" +\n        String(data.timestamp || '') + \"', '\" +\n        data.received + \"');\"\n};\n\nvar wsMsg = {\n    payload: JSON.stringify({\n        type: 'sensor_update',\n        data: data,\n        threshold: threshold,\n        alert: isAlert,\n        alert_message: alertMsg\n    })\n};\n\nvar dbgMsg = { payload: { data: data, threshold: threshold, alert: isAlert } };\n\nreturn [sqlMsg, wsMsg, dbgMsg];",
        "outputs": 3,
        "x": 420,
        "y": 150,
        "wires": [
            [
                "a62d6c4b66de1d49"
            ],
            [
                "d8b95eb22e23dc06"
            ],
            [
                "54aa0ca29a8d5701"
            ]
        ]
    },
