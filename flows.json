    {
        "id": "c0f13fac3821040d",
        "type": "function",
        "z": "b4ccd42c70018948",
        "name": "Auth & Response Suhu",
        "func": "const VALID_KEY = 'iot-secret-key-2026';\nconst apiKey = msg.req.headers['x-api-key'];\nmsg.headers = { 'Access-Control-Allow-Origin': '*' };\n\nif (apiKey !== VALID_KEY) {\n    msg.statusCode = 401;\n    msg.payload = { status: 'error', message: 'Unauthorized: X-API-Key tidak valid' };\n    return msg;\n}\n\nvar data = flow.get('lastSensor') || { suhu: null, kelembaban: null, timestamp: null };\nvar threshold = flow.get('threshold') !== undefined ? flow.get('threshold') : 30;\n\nmsg.statusCode = 200;\nmsg.payload = {\n    status: 'success',\n    data: data,\n    threshold: threshold,\n    server_time: new Date().toISOString()\n};\nreturn msg;",
        "outputs": 1,
        "x": 400,
